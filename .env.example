# Raspberry Pi device identity
HEARO_HOUSEHOLD_ID=replace-with-household-id
HEARO_DEVICE_CREDENTIAL=replace-with-device-credential

# FastAPI and MQTT endpoints. Production API must use HTTPS and MQTT TLS.
HEARO_API_BASE_URL=https://api.example.com
HEARO_MQTT_HOST=mqtt.example.com
HEARO_MQTT_PORT=8883
HEARO_MQTT_USERNAME=replace-with-device-username
HEARO_MQTT_PASSWORD=replace-with-device-password
HEARO_MQTT_CA_PATH=/etc/ssl/certs/ca-certificates.crt

# Optional input-device override; set one after checking `python -m sounddevice`.
# HEARO_MIC_DEVICE_INDEX=1
# HEARO_MIC_DEVICE_NAME=i2s
# Optional RMS gate. Raise it only after measuring the microphone's quiet baseline.
# HEARO_SILENCE_RMS_THRESHOLD=0.003

# appAWS_v3.py only: must match the three ESP32 nodes and be at least 16 bytes.
HEARO_AUDIO_PSK=replace-with-a-random-lan-audio-key
HEARO_AUDIO_BIND_HOST=0.0.0.0
HEARO_AUDIO_PORT=41000

# Compatibility switch during the MQTT topic migration.
HEARO_PUBLISH_LEGACY_TOPICS=true
