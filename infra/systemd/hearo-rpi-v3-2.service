[Unit]
Description=Hearo Raspberry Pi audio inference v3.2
After=network-online.target sound.target
Wants=network-online.target
Conflicts=hearo-rpi.service

[Service]
Type=simple
User=team7
Group=team7
SupplementaryGroups=audio gpio
WorkingDirectory=/home/team7/raspberry-pi
EnvironmentFile=/home/team7/.config/hearo/device-runtime.env
Environment=HEARO_MODEL_PROFILE=v3_2
Environment=PYTHONUNBUFFERED=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=/home/team7/hearo-env/bin/python -u /home/team7/raspberry-pi/appAWS_v3_2.py

Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

StateDirectory=hearo
StateDirectoryMode=0750
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
